# syntax=docker/dockerfile:1.7

FROM pytorch/pytorch:2.6.0-cuda12.4-cudnn9-runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    TOKENIZERS_PARALLELISM=false \
    HF_HOME=/work/huggingface \
    TRANSFORMERS_CACHE=/work/huggingface \
    MODEL_PATH=/work/model \
    OUTPUT_DIR=/work/output \
    CACHE_DIR=/work/cache

WORKDIR /app

COPY requirements_worker.txt /app/requirements_worker.txt

RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install -r /app/requirements_worker.txt

COPY src /app/src

RUN python -m py_compile \
      /app/src/workers/inference_worker_v5.py \
      /app/src/cloud/batch_worker_entrypoint.py \
      /app/src/state/job_state_store.py \
      /app/src/state/dynamodb_job_state_store.py \
      /app/src/storage/s3_artifact_store.py \
    && python -c "import torch, transformers, boto3, awscrt; from qwen_vl_utils import process_vision_info; print('torch=', torch.__version__); print('transformers=', transformers.__version__); print('container imports passed')"

RUN mkdir -p /work/model /work/output /work/cache /work/huggingface

ENTRYPOINT ["python", "-m", "src.cloud.batch_worker_entrypoint"]
